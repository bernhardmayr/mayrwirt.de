# Lokal (SQLite)
DATABASE_URL="file:./prisma/dev.db"

# Produktion (Turso) – Format: libsql://[db-name]-[org].turso.io
# DATABASE_URL="libsql://your-db-name-your-org.turso.io?authToken=your-token"

NEXTAUTH_SECRET="your-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"   # Produktion: https://ihre-domain.vercel.app

# Anthropic (optional – ohne Key läuft der KI-Mock)
ANTHROPIC_API_KEY=""

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google Business Profile (optional)
GOOGLE_BUSINESS_CLIENT_ID=""
GOOGLE_BUSINESS_CLIENT_SECRET=""

# TripAdvisor (optional)
TRIPADVISOR_API_KEY=""
TRIPADVISOR_CLIENT_ID=""
TRIPADVISOR_CLIENT_SECRET=""
