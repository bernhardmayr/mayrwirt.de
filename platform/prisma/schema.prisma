generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  company       Company?
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Company {
  id          String   @id @default(cuid())
  name        String
  description String?
  language    String   @default("de")
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())

  connections PlatformConnection[]
  feedbacks   Feedback[]
  actions     Action[]
}

model PlatformConnection {
  id           String    @id @default(cuid())
  companyId    String
  provider     String
  externalId   String?
  displayName  String?
  accessToken  String?
  refreshToken String?
  tokenExpiry  DateTime?
  status       String    @default("active")
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())

  company   Company    @relation(fields: [companyId], references: [id])
  feedbacks Feedback[]

  @@unique([companyId, provider, externalId])
}

model Feedback {
  id             String    @id @default(cuid())
  companyId      String
  connectionId   String?
  externalId     String?
  source         String
  authorName     String?
  rating         Int?
  title          String?
  body           String
  publishedAt    DateTime
  language       String?
  responseStatus String    @default("pending")
  responseDraft  String?
  responseText   String?
  respondedAt    DateTime?
  aiSuggestion   String?
  aiGeneratedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company    Company             @relation(fields: [companyId], references: [id])
  connection PlatformConnection? @relation(fields: [connectionId], references: [id])
  actions    Action[]

  @@unique([source, externalId])
  @@index([companyId, responseStatus])
  @@index([companyId, publishedAt])
}

model Action {
  id          String    @id @default(cuid())
  companyId   String
  feedbackId  String?
  title       String
  description String?
  priority    String    @default("medium")
  status      String    @default("open")
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company  Company   @relation(fields: [companyId], references: [id])
  feedback Feedback? @relation(fields: [feedbackId], references: [id])
}
